;;; pong -- Pong
;;;
;;; Two paddles, a ball and a score: W/S and Up/Down move the paddles,
;;; Space serves. Held keys are polled with is-key-down, the serve is an
;;; edge (is-key-pressed), and the score is centred with measure-text. The
;;; score line is rebuilt only when a point is scored, not every frame.
;;;
;;; Runs natively too: tur --enable=script-deps run 09-pong.tur
(defscript :spices #map{"raylib" #map{:url "https://github.com/turmeric-lang/turmeric-spices"
                                      :ref "c5864091a3487d8219761e8f489e97ce6a584a86"
                                      :subdir "spices/raylib"}})

(defmodule pong
  (export)
  (load "stdlib/math.tur")        ; float->int, fabs
  (load "stdlib/str-build.tur")   ; int->str, str-concat
  (import raylib/core   :refer [init-window window-should-close begin-drawing
                                end-drawing clear-background set-target-fps
                                get-frame-time])
  (import raylib/shapes :refer [draw-circle draw-rectangle])
  (import raylib/text   :refer [draw-text measure-text])
  (import raylib/input  :refer [is-key-down is-key-pressed])
  (import raylib/color  :refer [color raywhite black gray])

  (def key-space 32) (def key-w 87) (def key-s 83)
  (def key-up 265) (def key-down 264)
  (def width 480)
  (def pad-w 8) (def pad-h 48)
  (def pad-speed 260.0)
  (def left-x 16.0) (def right-x 456.0)   ; each paddle's left edge
  (def radius 5.0)

  ;; A paddle's next y: moved by its keys, kept inside the pane.
  (defn move-paddle [y : float up : int down : int dt : float] : float
    (let [^mut ny y]
      (when (is-key-down up)   (set! ny (- ny (* pad-speed dt))))
      (when (is-key-down down) (set! ny (+ ny (* pad-speed dt))))
      (cond (< ny 0.0)   0.0
            (> ny 222.0) 222.0                  ; 270 less the paddle
            :else        ny)))

  ;; Does the ball at (bx, by) touch the paddle whose top-left is (px, py)?
  (defn hits? [bx : float by : float px : float py : float] : bool
    (and (> (+ bx radius) px) (< (- bx radius) (+ px 8.0))
         (> (+ by radius) py) (< (- by radius) (+ py 48.0))))

  (defn score-line [l : int r : int] : cstr
    (str-concat (int->str l) (str-concat "   " (int->str r))))

  (defn main [] : int
    (init-window width 270 "pong")
    (set-target-fps 60)
    (let [bg      (raywhite)
          ink     (black)
          dim     (gray)
          paddle  (color 40 60 160 255)
          ball    (color 230 90 30 255)
          ^mut lp 111.0                          ; paddle tops
          ^mut rp 111.0
          ^mut bx 240.0
          ^mut by 135.0
          ^mut vx 0.0
          ^mut vy 0.0
          ^mut serving true
          ^mut serve-dir 1.0                     ; towards whoever lost the point
          ^mut ls 0
          ^mut rs 0
          ^mut score (score-line 0 0)]
      (while (not (window-should-close))
        (let [dt (get-frame-time)]
          (set! lp (move-paddle lp key-w key-s dt))
          (set! rp (move-paddle rp key-up key-down dt))
          (when (and serving (is-key-pressed key-space))
            (set! serving false)
            (set! vx (* 220.0 serve-dir))
            (set! vy 90.5))
          (set! bx (+ bx (* vx dt)))
          (set! by (+ by (* vy dt)))
          ;; Walls, then paddles: each turns the ball only while it moves
          ;; towards it, so a ball inside a paddle cannot stick there. Where
          ;; it meets the paddle sets the new angle, and every return is a
          ;; little faster.
          (when (or (and (< by radius) (< vy 0.0)) (and (> by 265.0) (> vy 0.0)))
            (set! vy (- 0.0 vy)))
          (when (and (< vx 0.0) (hits? bx by left-x lp))
            (set! vx (* 1.05 (fabs vx)))
            (set! vy (* 5.0 (- by (+ lp 24.0)))))
          (when (and (> vx 0.0) (hits? bx by right-x rp))
            (set! vx (- 0.0 (* 1.05 vx)))
            (set! vy (* 5.0 (- by (+ rp 24.0)))))
          ;; A point: the ball left the pane.
          (when (or (< bx 0.0) (> bx 480.0))
            (if (< bx 0.0)
              (do (set! rs (+ rs 1)) (set! serve-dir -1.0))
              (do (set! ls (+ ls 1)) (set! serve-dir 1.0)))
            (set! score (score-line ls rs))
            (set! bx 240.0) (set! by 135.0) (set! vx 0.0) (set! vy 0.0)
            (set! serving true))
          (begin-drawing)
          (clear-background bg)
          (let [^mut dash 0]                     ; the centre line
            (while (< dash 270)
              (draw-rectangle 239 dash 2 10 dim)
              (set! dash (+ dash 20))))
          (draw-text score (- 240 (/ (measure-text score 30) 2)) 12 30 ink)
          (draw-rectangle (float->int left-x) (float->int lp) pad-w pad-h paddle)
          (draw-rectangle (float->int right-x) (float->int rp) pad-w pad-h paddle)
          (draw-circle (float->int bx) (float->int by) radius ball)
          (when serving
            (draw-text "SPACE to serve" (- 240 (/ (measure-text "SPACE to serve" 16) 2)) 200 16 dim))
          (end-drawing))))
    0))
